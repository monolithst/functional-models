{
  "name": "functional-models",
  "version": "3.12.0",
  "description": "Functional models is ooey gooey framework for building and using awesome models EVERYWHERE.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "build": "rm -Rf ./dist && npm run build:esm && npm run build:cjs && npm run build:dist-package && cp README.md ./dist",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "node bin/build-cjs.mjs",
    "build:dist-package": "node bin/prepare-dist-package.mjs",
    "build:docs": "npx typedoc --out ./buildDocs ./src/index.ts",
    "build:watch": "nodemon -e '*' --watch ./src --exec npm run build",
    "commit": "cz",
    "dist": "npm run build && npm run build:docs && cd dist && npm publish && cd ../knowledge-mcp && npm run dist",
    "eslint": "eslint . --fix",
    "mocha": "mocha -r tsx",
    "prettier": "prettier --write .",
    "prettier:check": "prettier -c .",
    "test": "mocha -r tsx --extensions ts,tsx 'test/src/**/*.{ts,tsx}'",
    "test:dist": "npm run build && mocha -r tsx 'test/dist/**/*.test.ts'",
    "test:features": "./node_modules/.bin/cucumber-js -p default",
    "test:coverage": "nyc --all --reporter cobertura --reporter text --reporter lcov --reporter html npm run test",
    "test:watch": "nodemon -e '*' --watch test --watch src --exec npm run test:coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monolithst/functional-models.git"
  },
  "keywords": [
    "framework",
    "models",
    "orm",
    "modeling",
    "functional"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "author": "Mike Cornwell",
  "license": "GPLV3",
  "bugs": {
    "url": "https://github.com/monolithst/functional-models/issues"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "homepage": "https://monolithst.github.io/functional-models/",
  "devDependencies": {
    "@cucumber/cucumber": "^13.0.0",
    "@date-fns/utc": "^1.2.0",
    "@eslint/compat": "^1.2.0",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.12.0",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/async-lock": "^1.1.3",
    "@types/chai": "^5.0.1",
    "@types/chai-as-promised": "^7.1.4",
    "@types/lodash": "^4.14.176",
    "@types/mocha": "^9.1.1",
    "@types/node": "^22.10.7",
    "@types/proxyquire": "^1.3.28",
    "@types/sinon": "^10.0.6",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@typescript/native-preview": "^7.0.0-dev.20260604.1",
    "chai": "^5.1.2",
    "chai-as-promised": "^7.1.1",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.0.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-functional": "~7.1.0",
    "eslint-plugin-import": "^2.31.0",
    "esprima": "^4.0.1",
    "globals": "^15.14.0",
    "mocha": "^11.0.1",
    "nodemon": "^3.1.0",
    "nyc": "^17.1.0",
    "prettier": "^3.4.2",
    "proxyquire": "^2.1.3",
    "sinon": "^18.0.1",
    "source-map-support": "^0.5.21",
    "ts-node": "^9.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "async-lock": "^1.3.0",
    "get-random-values": "^1.2.2",
    "lodash": "^4.18.1",
    "modern-async": "^2.0.4",
    "openapi-types": "^12.1.3",
    "uuid": "^14.0.0",
    "zod": "^4.1.11"
  },
  "overrides": {
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.5",
    "lodash": "^4.18.1",
    "tmp": "^0.2.7"
  }
}
